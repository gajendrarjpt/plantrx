[TEMPLATE]
# PlantRx Android (Capacitor) build variables.
# Copy this file to .env.android and fill in your own values.
# Never commit .env.android — it is gitignored.

# Marks this build as the Android app (renders the AdMob ad placeholder).
VITE_APP_PLATFORM=android

# The deployed PlantRx backend. Replace with your real Vercel domain
# (e.g. https://plantrx.vercel.app). The Android app calls this API — it never
# talks to Gemini directly, and PLANT_API_KEY stays server-side.
VITE_API_BASE_URL=https://plantrx-gamma.vercel.app
