# PlantRx environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# REQUIRED for real diagnoses. Free key from Google AI Studio:
#   https://aistudio.google.com/apikey
# (Gemini 2.5 Flash has a generous free tier — ideal for a zero-budget app.)
PLANT_API_KEY=

# OPTIONAL — local development only. Set to 1 to get a canned diagnosis
# without calling the Gemini API (useful for testing the UI):
# MOCK_DIAGNOSIS=1
